{
  "name": "posman-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.test.ts",
    "test:e2e": "python tests/e2e/run_ui_gallery.py && python tests/e2e/run_phase06.py && python tests/e2e/run_phase07.py && python tests/e2e/run_phase08.py && python tests/e2e/run_phase09.py",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:check": "tauri build --debug --no-bundle",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
